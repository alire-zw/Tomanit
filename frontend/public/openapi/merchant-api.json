{
  "openapi": "3.1.0",
  "info": {
    "title": "Tomanit Merchant API",
    "version": "1.0.0",
    "summary": "Create and track shop payment invoices",
    "description": "Canonical live OpenAPI: GET {API_BASE}/merchant/v1/openapi.json. Human docs: /docs/merchant-api"
  },
  "servers": [
    {
      "url": "https://api.tunne.lol/merchant/v1",
      "description": "Production Merchant API v1"
    }
  ],
  "tags": [
    { "name": "Invoices", "description": "Create invoices and query payment status" },
    { "name": "Callbacks", "description": "HTTPS webhooks POSTed to your callbackUrl" }
  ],
  "components": {
    "securitySchemes": {
      "ShopApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "TomanIt:{shopId}:{token}",
        "description": "Shop API key from Mini App → Shop → API. Format: TomanIt:{shopId}:{token}"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["error"]
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "code": { "type": "string", "example": "TMNIT-100001" },
          "payToken": { "type": "string", "example": "100001482391" },
          "amountToman": { "type": "integer", "example": 250000 },
          "status": {
            "type": "string",
            "enum": ["open", "paid", "cancelled", "expired"]
          },
          "phone": { "type": ["string", "null"] },
          "telegramId": { "type": ["string", "null"] },
          "callbackUrl": { "type": ["string", "null"], "format": "uri" },
          "webUrl": { "type": ["string", "null"], "format": "uri" },
          "miniAppUrl": { "type": ["string", "null"], "format": "uri" },
          "url": { "type": ["string", "null"], "format": "uri" },
          "paidAt": { "type": ["string", "null"], "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "code", "payToken", "amountToman", "status", "createdAt"]
      },
      "CreateInvoiceRequest": {
        "type": "object",
        "required": ["amountToman", "expiresInMinutes", "callbackUrl"],
        "properties": {
          "amountToman": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 500000000,
            "example": 250000
          },
          "expiresInMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 25,
            "example": 15
          },
          "callbackUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://yoursite.com/hooks/tomanit-invoice"
          },
          "phone": { "type": "string", "nullable": true, "example": "09121234567" },
          "telegramId": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }],
            "nullable": true,
            "example": 123456789
          }
        }
      },
      "InvoiceResponse": {
        "type": "object",
        "required": ["invoice"],
        "properties": {
          "invoice": { "$ref": "#/components/schemas/Invoice" }
        }
      },
      "CallbackPayload": {
        "type": "object",
        "required": ["event", "invoice"],
        "properties": {
          "event": {
            "type": "string",
            "enum": ["invoice.paid", "invoice.failed"]
          },
          "invoice": { "$ref": "#/components/schemas/Invoice" }
        }
      }
    }
  },
  "security": [{ "ShopApiKey": [] }],
  "paths": {
    "/invoices": {
      "post": {
        "tags": ["Invoices"],
        "operationId": "createInvoice",
        "summary": "Create invoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateInvoiceRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invoice created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvoiceResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/invoices/{ref}": {
      "get": {
        "tags": ["Invoices"],
        "operationId": "getInvoice",
        "summary": "Get invoice status",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "payToken or TMNIT-code",
            "example": "TMNIT-100001"
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvoiceResponse" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "x-webhooks": {
    "invoiceStatus": {
      "post": {
        "tags": ["Callbacks"],
        "operationId": "invoiceStatusCallback",
        "summary": "Payment status callback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CallbackPayload" }
            }
          }
        },
        "responses": {
          "200": { "description": "Acknowledge receipt" }
        }
      }
    }
  }
}
