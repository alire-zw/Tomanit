{
  "name": "tomanit-backend",
  "version": "1.0.0",
  "description": "Tomanit Telegram mini-app crypto exchange API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:sync": "node scripts/sync-db-provider.mjs",
    "db:generate": "npm run db:sync && prisma generate",
    "db:push": "npm run db:sync && prisma db push",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^6.5.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jalaali-js": "^2.0.1",
    "undici": "^7.29.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
