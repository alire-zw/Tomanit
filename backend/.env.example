# Application
NODE_ENV=development
PORT=4321

# Public URLs
PUBLIC_URL=https://paneloutdev.mirall.ir
MINI_APP_URL=https://pnldevb.mirall.ir

# Database (postgresql recommended)
DB_PROVIDER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tomanit
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/tomanit?schema=public
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_API_ROOT=https://api.telegram.org
# TELEGRAM_PROXY=http://127.0.0.1:12334
# Optional Iranian exit for SEP/Zibal (http:// or socks4/5://)
# GATEWAY_PROXY=socks5://user:pass@IRAN_HOST:PORT
# Shop report bot (separate bot; long-polling) — leave empty to disable
# SHOP_REPORT_BOT_TOKEN=
# SHOP_REPORT_BOT_USERNAME=
AUTH_MAX_AGE_SEC=86400
WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_SECRET=
# FORCE_WEBHOOK_SYNC=1

# Custodial wallet + chain providers
# WALLET_MASTER_KEY=
# TRON_NETWORK=shasta
# TRONGRID_API_KEY=
# ANKR_API_KEY=
# TONCENTER_API_KEY=

# SwapWallet market prices (IRT/toman)
SWAPWALLET_API_KEY=
